        "function unsupportedDatabaseConnection(connection: never): never { throw new Error(\"Unsupported database connection kind.\"); }",
        "export function createPhaseBServerAiAvailabilityV1() {",
        "  const trustedEnvironment = Object.freeze({ appEnvironment: env.APP_ENV, processFeatureAiEnabled: env.FEATURE_AI }) satisfies TrustedPhaseBEnvironmentV1;",
        "  switch (databaseConnection.kind) {",
        "    case \"pglite\": return createPhaseBAvailabilityServiceV1({ database: databaseConnection.db, trustedEnvironment });",
