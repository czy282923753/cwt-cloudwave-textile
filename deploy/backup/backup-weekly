#!/bin/sh
. "$(dirname -- "$0")/common.sh"
init_backup
lock_backup
restic_repository
source_database
# Stable path lets Restic deduplicate/group without inventing a second catalogue.
slot="$BACKUP_WORK_ROOT/.weekly-work"
mkdir "$slot" || refuse incomplete-weekly-work
trap 'rm -rf -- "$slot"' EXIT
trap 'exit 1' HUP INT TERM
(cd "$slot" && node "$backup_bin/database-run.mjs" psql -XAtq -v ON_ERROR_STOP=1 -v objects_sql="$backup_bin/objects.sql" -f "$backup_bin/snapshot.sql" >/dev/null 2>&1) || refuse snapshot-copy
node "$backup_bin/files.mjs" configuration "$slot"
node "$backup_bin/files.mjs" seal "$slot" weekly
"$backup_bin/verify-backup-set" "$slot" >/dev/null
# The helper handles standard Restic JSON and the exact new snapshot only.
node "$backup_bin/weekly.mjs" backup "$slot"
