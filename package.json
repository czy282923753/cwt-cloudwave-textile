{
  "name": "cwt-cloudwave-textile",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.14.0",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "env:check": "node scripts/check-runtime.mjs",
    "env:diagnose": "node scripts/diagnose-environment.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-public-bundle.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:fixtures": "tsx scripts/seed-fixtures.ts",
    "db:verify": "tsx scripts/verify-database.ts",
    "db:verify:ai-foundation-candidate": "tsx scripts/verify-ai-foundation-candidate.ts",
    "db:validate:postgres": "tsx scripts/verify-postgres-round2.ts",
    "assets:rescan-legacy": "tsx scripts/rescan-legacy-assets.ts",
    "retention:preview": "tsx scripts/enforce-retention.ts",
    "retention:execute": "tsx scripts/enforce-retention.ts --execute",
    "outbox:process": "tsx scripts/process-notification-outbox.ts",
    "cleanup:objects": "tsx scripts/process-object-cleanup.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test:run && pnpm build && pnpm check:bundle",
    "check:all": "pnpm check && pnpm audit --prod && pnpm test:e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1101.0",
    "@aws-sdk/s3-request-presigner": "3.1101.0",
    "@electric-sql/pglite": "0.5.4",
    "@refinedev/core": "5.0.12",
    "@refinedev/nextjs-router": "7.0.5",
    "@tanstack/react-query": "5.101.4",
    "@zip.js/zip.js": "2.8.34",
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "nodemailer": "9.0.3",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "saxes": "6.0.0",
    "server-only": "0.0.1",
    "sharp": "0.35.3",
    "write-excel-file": "4.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
