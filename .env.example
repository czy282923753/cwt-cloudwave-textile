# Runtime
APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NON_PRODUCTION_NOINDEX=true

# Database: pglite is permitted for local/test. Protected environments use
# environment-prefixed Docker secret files and bounded per-process pools.
DATABASE_DRIVER=pglite
DATABASE_URL=
DATABASE_URL_FILE=
DATABASE_POOL_MAX=10
PGLITE_DATA_DIR=.data/pglite

# Authentication
AUTH_SESSION_SECRET=replace-with-a-local-development-secret-at-least-32-characters
AUTH_SESSION_SECRET_FILE=
AUTH_COOKIE_NAME=cwt_session
ANALYTICS_CONSENT_COOKIE_NAME=cwt_analytics_consent
DEV_ADMIN_EMAIL=admin@example.test
DEV_ADMIN_PASSWORD=replace-with-local-only-password

# Storage
STORAGE_DRIVER=local
PUBLIC_STORAGE_ROOT=.storage/public
PRIVATE_STORAGE_ROOT=.storage/private
IMPORT_STORAGE_ROOT=.storage/imports
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BUCKET=
S3_PRIVATE_BUCKET=
S3_IMPORT_BUCKET=

# File validation and scanning
MAX_PUBLIC_FILE_BYTES=12582912
MAX_INQUIRY_FILE_BYTES=12582912
MAX_FILES_PER_UPLOAD=8
MAX_UPLOAD_INTENT_JSON_BYTES=8192
MAX_INQUIRY_JSON_BYTES=32768
UPLOAD_INTENT_TTL_SECONDS=900
TRUSTED_PROXY_MODE=none
FILE_SCAN_DRIVER=development
FILE_SCAN_ORIGIN=
FILE_SCAN_API_KEY=
FILE_SCAN_API_KEY_FILE=
FILE_SCAN_ACCOUNT_CUSTODY=
PRIVATE_URL_TTL_SECONDS=300
INQUIRY_FILE_RETENTION_DAYS=
CUSTOMER_DATA_RETENTION_DAYS=
AUDIT_LOG_RETENTION_DAYS=
SHARED_RATE_LIMIT_DRIVER=memory
VALKEY_ENDPOINT=
VALKEY_USERNAME=
VALKEY_PASSWORD=
VALKEY_PASSWORD_FILE=
RATE_LIMIT_KEY_PREFIX=

# Internal inquiry email delivery
EMAIL_DRIVER=log
EMAIL_FROM=
INQUIRY_NOTIFICATION_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_PASSWORD_FILE=

# Analytics and monitoring
ANALYTICS_DRIVER=disabled
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
GSC_SITE_URL=
MONITORING_DRIVER=log
SENTRY_DSN=
SENTRY_DSN_FILE=

# Protected integration and backup custody (file inputs only outside local/test)
AI_PROVIDER_API_KEY=
AI_PROVIDER_API_KEY_FILE=
COS_ACCESS_KEY_ID=
COS_ACCESS_KEY_ID_FILE=
COS_SECRET_ACCESS_KEY=
COS_SECRET_ACCESS_KEY_FILE=
BACKUP_REPOSITORY_PASSWORD=
BACKUP_REPOSITORY_PASSWORD_FILE=

# Feature flags
FEATURE_REFINE_ADMIN=true
FEATURE_SOURCE_DECLARATION=false
FEATURE_AI=false
FEATURE_SEO_ASSISTANT=false
