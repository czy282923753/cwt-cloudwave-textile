# Runtime
APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NON_PRODUCTION_NOINDEX=true

# Database: pglite is permitted for local/test; production must use postgres.
DATABASE_DRIVER=pglite
DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite

# Authentication
AUTH_SESSION_SECRET=replace-with-a-local-development-secret-at-least-32-characters
AUTH_COOKIE_NAME=cwt_session
DEV_ADMIN_EMAIL=admin@example.test
DEV_ADMIN_PASSWORD=replace-with-local-only-password

# Storage
STORAGE_DRIVER=local
PUBLIC_STORAGE_ROOT=.storage/public
PRIVATE_STORAGE_ROOT=.storage/private
IMPORT_STORAGE_ROOT=.storage/imports
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BUCKET=
S3_PRIVATE_BUCKET=
S3_IMPORT_BUCKET=

# File validation and scanning
MAX_PUBLIC_FILE_BYTES=12582912
MAX_INQUIRY_FILE_BYTES=12582912
MAX_FILES_PER_UPLOAD=8
FILE_SCAN_DRIVER=development
FILE_SCAN_ENDPOINT=
FILE_SCAN_TOKEN=
PRIVATE_URL_TTL_SECONDS=300

# Email and contact channels
EMAIL_DRIVER=log
EMAIL_FROM=
INQUIRY_NOTIFICATION_TO=
WHATSAPP_NUMBER=

# Analytics and monitoring
ANALYTICS_DRIVER=disabled
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
GSC_SITE_URL=
MONITORING_DRIVER=log

# Feature flags
FEATURE_REFINE_ADMIN=true
FEATURE_SOURCE_DECLARATION=true
FEATURE_AI=false
FEATURE_SEO_ASSISTANT=false
